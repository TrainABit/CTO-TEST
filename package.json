{
  "name": "project",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@8.15.4",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "pnpm exec eslint . --max-warnings=0",
    "lint:eslint": "eslint . --max-warnings=0",
    "format": "prettier --check .",
